# xlint exclusion file — gitignore format
# Keep the built-in defaults (__pycache__, .git, node_modules, xlib_legacy) and add:

# pybundle test fixtures violate import rules deliberately; they are bundler input,
# not code the project owns.
tools/pybundle/test/fixtures/

# .agents/ is gitignored scratch (agent notes, shared notes, claims) and no clone
# will ever have it. But we exclude it explicitly rather than driving from
# .gitignore, because the exclusion list is a style statement, not a tracking one.
.agents/

# .work/ holds per-ticket worktrees, one per ticket — not part of the project.
# The rule governs this checkout only: a worktree holds its own copy of this file,
# and the copy that applies inside a worktree is that worktree's own, so a worktree
# is excluded here and linted there.
.work/

# dev/xhttp/compare/web/ holds the websocket RFC comparison material, and with it
# the only .html file in this repo. It is 4-space indented and not code the project
# owns, so the html rules would report it for its indent unit rather than for
# anything about it. The narrow path: the 10 .py files beside it stay linted.
dev/xhttp/compare/web/
