#!/bin/sh
# xlint pre-commit hook — runs xlint on staged .py/.md files.
# Install: tools/hooks/install.sh

set -eu

# Resolve the repo root so this works from any worktree.
root=$(git rev-parse --show-toplevel)
if [ -z "$root" ]; then
	echo "xlint-hook: not a git repository" >&2
	exit 1
fi

# Collect staged .py, .md and .sh files. The shell scripts carry no style rules,
# but they are files a personal identifier can be pasted into, and the
# personal-identifier check is what catches that.
#
# The list is NUL-separated and handed to xlint with `xargs -0`, because a
# filename may contain a space: a newline-joined list expanded as `$staged`
# word-splits into half a filename, and xlint then reports "not found" for a path
# that was never a path — the commit is refused with a style message naming
# nothing real. `-r` keeps a run with nothing staged from invoking xlint at all.

# Find xlint without assuming this checkout holds it. A workspace that borrows
# the tools reaches them through a symlinked tools/; one that installs them gets
# the command on PATH, from XLib's install.sh. An explicit XLIB wins, then this
# checkout's copy, then the installed command.
xlint=""
if [ -n "${XLIB:-}" ] && [ -f "$XLIB/tools/xlint/xlint.py" ]; then
	xlint="$XLIB/tools/xlint/xlint.py"
elif [ -f "$root/tools/xlint/xlint.py" ]; then
	xlint="$root/tools/xlint/xlint.py"
elif command -v xlint >/dev/null 2>&1; then
	xlint=$(command -v xlint)
fi

if [ -z "$xlint" ]; then
	echo "xlint-hook: xlint was not found, so the style gate cannot run." >&2
	echo "xlint-hook: looked for \$XLIB/tools/xlint/xlint.py, $root/tools/xlint/xlint.py and 'xlint' on PATH." >&2
	echo "xlint-hook: install the tools from XLib (bash install.sh links xlint into ~/.local/bin), or set XLIB to an XLib checkout." >&2
	echo "xlint-hook: refusing the commit rather than passing it unchecked." >&2
	exit 1
fi

# Run xlint from the repo root, so the staged paths resolve.
cd "$root"
if ! git diff --cached --name-only --diff-filter=ACM -z -- '*.py' '*.md' '*.sh' \
	| xargs -0 -r python3 "$xlint" --; then
	echo "xlint-hook: commit blocked by style violations above." >&2
	echo "xlint-hook: run 'python3 $xlint <files>' to see details." >&2
	echo "xlint-hook: bypass with 'git commit --no-verify' (not recommended)." >&2
	exit 1
fi

exit 0