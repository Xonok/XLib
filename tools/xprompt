}

ENABLED_TOOLS = set()

HELP = __doc__


def fail(msg, code=2):
	sys.stderr.write(f"{NAME}: {msg}\n")
	sys.exit(code)


def human_size(n):
	if n >= 1024 * 1024 * 1024:
		return f"{n / (1024**3):.1f}G"
	if n >= 1024 * 1024:
		return f"{n / (1024**2):.1f}M"
	if n >= 1024:
		return f"{n / 1024:.1f}K"
	return f"{n}B"


def normalize_host(value=None):
	if value is None:
		value = os.environ.get("OLLAMA_HOST", "http://localhost:11434")
	value = str(value).strip()
	host = ""
	port = None
	if "://" in value:
		parsed = urlparse(value)
		host = parsed.hostname or ""
		port = parsed.port
	else:
		if ":" in value:
			h, sep, pstr = value.rpartition(":")
			try:
				port = int(pstr)
				host = h
			except ValueError:
				host = value
				port = None
		else:
			host = value
	if not host:
		host = "localhost"
	if port is None:
		port = 11434
	return host, int(port)


def coerce_option_value(value):
	s = value
	low = str(s).lower()
	if low == "true":
		return True
	if low == "false":
		return False
	if re.fullmatch(r"[+-]?\d+", str(s)):
		return int(s)
	try:
		return float(s)
	except (TypeError, ValueError):
		return s


def parse_show_parameters(text):
	result = {"num_ctx": None, "num_gpu": None, "num_thread": None}
	if not text:
		return result
	for line in str(text).splitlines():
		parts = line.split()
		if len(parts) < 2:
			continue
		key = parts[0]
		val = parts[1]
		if key in result:
			result[key] = val
	return result


def fetch_tags(host=None):
	h, p = normalize_host(host)
	try:
		conn = http.client.HTTPConnection(h, p, timeout=10)
		conn.request("GET", "/api/tags")
		resp = conn.getresponse()
		raw = resp.read()
		conn.close()
	except Exception as e:
		fail(f"cannot reach Ollama: {e}", 1)
	if resp.status != 200:
		fail(f"Ollama HTTP {resp.status}: {raw.decode(errors='replace')}", 1)
	try:
		data = json.loads(raw)
	except json.JSONDecodeError as e:
		fail(f"bad response from Ollama: {e}", 1)
	return data


def fetch_show(model, host=None):
	h, p = normalize_host(host)
	try:
		conn = http.client.HTTPConnection(h, p, timeout=10)
		data = json.dumps({"model": model}).encode()
		conn.request("POST", "/api/show", body=data, headers={"Content-Type": "application/json"})
		resp = conn.getresponse()
		raw = resp.read()
		conn.close()
	except Exception as e:
		fail(f"cannot reach Ollama: {e}", 1)
	if resp.status != 200:
		fail(f"Ollama HTTP {resp.status}: {raw.decode(errors='replace')}", 1)
	try:
		data = json.loads(raw)
	except json.JSONDecodeError as e:
		fail(f"bad response from Ollama: {e}", 1)
	return data


def list_models(detail=False, host=None):
	data = fetch_tags(host)
	models = data.get("models", [])
	if not models:
		print("no models installed")
		return
	show_data = {}
	if detail:
		for m in models:
			name = m.get("name", "")
			try:
				sd = fetch_show(name, host)
				show_data[name] = sd
			except SystemExit:
				raise
			except Exception as e:
				show_data[name] = {}
	width = max(len(m.get("name", "")) for m in models)
	param_width = 8
	quant_width = 10
	ctx_width = 8
	for m in sorted(models, key=lambda x: x.get("name", "")):
		name = m.get("name", "")
		size = human_size(m.get("size", 0))
		caps = ", ".join(m.get("capabilities", []))
		details = m.get("details", {}) or {}
		param = details.get("parameter_size")
		if param is None:
			param = "-"
		quant = details.get("quantization_level")
		if quant is None:
			quant = "-"
		ctx = details.get("context_length")
		if ctx is None:
			ctx = "-"
		row = f"{name:<{width}}  {size:>6}  {str(param):>{param_width}}  {str(quant):<{quant_width}}  {str(ctx):>{ctx_width}}"
		if detail:
			sd = show_data.get(name, {}) or {}
			params_str = sd.get("parameters", "") if isinstance(sd, dict) else ""
			parsed = parse_show_parameters(params_str)
			num_ctx = parsed.get("num_ctx")
			if num_ctx is None:
				num_ctx = "-"
			num_gpu = parsed.get("num_gpu")
			if num_gpu is None:
				num_gpu = "-"
			num_thread = parsed.get("num_thread")
			if num_thread is None:
				num_thread = "-"
			row += f"  {num_ctx}  {num_gpu}  {num_thread}"
		if caps:
			row += f"  {caps}"
		print(row)


def read_file_text(path):
	try:
		with open(path, "r", encoding="utf-8", errors="replace") as f:
			lines = f.readlines()
	except OSError as e:
		return f"[error reading {path}: {e}]"
	truncated = False
	if len(lines) > MAX_FILE_LINES:
		lines = lines[:MAX_FILE_LINES]
		truncated = True
	text = "".join(lines)
	if len(text) > MAX_FILE_BYTES:
		text = text[:MAX_FILE_BYTES]
		truncated = True
	if truncated:
		text += f"\n... [truncated: {path}]"
	return text


def read_prompt_file(path):
	# no MAX_FILE_BYTES cap: this is the prompt itself, not an included file
	try:
		with open(path, "r", encoding="utf-8") as f:
			return f.read()
	except OSError as e:
		fail(f"cannot read prompt file {path}: {e}")


def tool_read(args):
	path = args.get("path")
	if not path:
		return "[error: missing 'path']"
	if not os.path.isfile(path):
		return f"[error: not a file: {path}]"
	return read_file_text(path)


def tool_grep(args):
	pattern = args.get("pattern")
	if not pattern:
		return "[error: missing 'pattern']"
	path = args.get("path", ".")
	try:
		regex = re.compile(pattern)
	except re.error as e:
		return f"[error: bad regex: {e}]"
	matches = []
	count = 0
	if os.path.isfile(path):
		files = [path]
	else:
		files = []
		for root, dirs, fnames in os.walk(path):
			dirs[:] = [d for d in dirs if d not in (".git", "__pycache__", "node_modules")]
			for fn in fnames:
				files.append(os.path.join(root, fn))
	for fp in files:
		try:
			with open(fp, "r", encoding="utf-8", errors="replace") as f:
				for i, line in enumerate(f, 1):
					if regex.search(line):
						matches.append(f"{fp}:{i}: {line.rstrip()}")
						count += 1
						if count >= MAX_GREP_MATCHES:
							break
		except OSError:
			continue
		if count >= MAX_GREP_MATCHES:
			break
	if not matches:
		return "[no matches]"
	out = "\n".join(matches)
	if count >= MAX_GREP_MATCHES:
		out += f"\n... [truncated at {MAX_GREP_MATCHES} matches]"
	return out


def tool_ls(args):
	path = args.get("path", ".")
	try:
		entries = sorted(os.listdir(path))
	except OSError as e:
		return f"[error: {e}]"
	lines = []
	for name in entries:
		full = os.path.join(path, name)
		suffix = "/" if os.path.isdir(full) else ""
		lines.append(name + suffix)
	return "\n".join(lines) if lines else "[empty directory]"


def tool_bash(args):
	command = args.get("command")
	if not command:
		return "[error: missing 'command']"
	try:
		timeout = int(args.get("timeout", 30))
	except (TypeError, ValueError):
		timeout = 30
	if timeout < 1:
		timeout = 1
	if timeout > 120:
		timeout = 120
	try:
		res = subprocess.run(
			["bash", "-c", command],
			capture_output=True,
			text=True,
			timeout=timeout,
			cwd=os.getcwd(),
		)
	except subprocess.TimeoutExpired:
		return f"[error: command timed out after {timeout}s]"
	except OSError as e:
		return f"[error: {e}]"
	out = res.stdout
	if res.stderr:
		out += ("" if out.endswith("\n") or not out else "\n") + res.stderr
	if res.returncode != 0:
		out += f"\n[exit code {res.returncode}]"
	if not out.strip():
		out = f"[exit code {res.returncode}]"
	return out


def tool_write(args):
	path = args.get("path")
	if not path:
		return "[error: missing 'path']"
	content = args.get("content")
	if content is None:
		return "[error: missing 'content']"
	if not isinstance(content, str):
		content = str(content)
	try:
		full = os.path.abspath(path)
		parent = os.path.dirname(full)
		if parent and not os.path.isdir(parent):
			os.makedirs(parent, exist_ok=True)
		with open(full, "w", encoding="utf-8") as f:
			f.write(content)
		byte_count = len(content.encode("utf-8"))
		return f"[wrote {byte_count} bytes to {path}]"
	except OSError as e:
		return f"[error: {e}]"


def execute_tool(name, args):
	if not isinstance(args, dict):
		args = {}
	if name == "read":
		return tool_read(args)
	if name == "grep":
		return tool_grep(args)
	if name == "ls":
		return tool_ls(args)
	if name == "bash":
		return tool_bash(args)
	if name == "write":
		return tool_write(args)
	return f"[error: unknown tool '{name}']"


def _positional_args(tool, toks):
	if tool == "read":
		if not toks:
			return {}
		return {"path": " ".join(toks)}
	if tool == "write":
		if not toks:
			return {}
		if len(toks) == 1:
			return {"path": toks[0], "content": ""}
		return {"path": toks[0], "content": " ".join(toks[1:])}
	if tool == "ls":
		# accept common flags like -a, -l as no-ops (ls already shows hidden)
		paths = [t for t in toks if not t.startswith("-")]
		if not paths:
			return {}
		return {"path": " ".join(paths)}
	if tool == "grep":
		if not toks:
			return {}
		if len(toks) == 1:
			return {"pattern": toks[0]}
		return {"pattern": toks[0], "path": " ".join(toks[1:])}
	return {}


_SHELL_BUILTINS = {"cd", "export", "source", ".", "alias", "echo", "printf", "read",
	"test", "[", "[[", "true", "false", "pwd", "unset", "local", "return"}


def _is_executable(token):
	if not token:
		return False
	if token in _SHELL_BUILTINS:
		return True
	if "/" in token:
		return os.path.isfile(token) and os.access(token, os.X_OK)
	return shutil.which(token) is not None


def _extract_bodies(text):
	bodies = []
	for m in re.finditer(r"```([^\n]*)\n(.*?)```", text, re.DOTALL):
		lang = m.group(1).strip().lower()
		bodies.append((m.group(2).strip(), True, lang))
	for m in re.finditer(r"<(?:tool_call|function_call|xml|tool)[^>]*>\s*(.*?)\s*</(?:tool_call|function_call|xml|tool)>", text, re.DOTALL | re.IGNORECASE):
		bodies.append((m.group(1).strip(), True, ""))
	bodies.append((text.strip(), False, ""))
	seen = set()
	out = []
	for b, f, lang in bodies:
		if b and b not in seen:
			seen.add(b)
			out.append((b, f, lang))
	return out


def parse_tool_calls_from_content(text):
	if not text:
		return []
	for body, fenced, lang in _extract_bodies(text):
		# bare tool name
		if body in TOOLS:
			return [normalize_call({"name": body, "arguments": {}})]
		parts = body.split(None, 1)
		if parts and parts[0] in TOOLS:
			name = parts[0]
			rest = parts[1].strip() if len(parts) > 1 else ""
			if not rest:
				return [normalize_call({"name": name, "arguments": {}})]
			# JSON arguments
			try:
				args = json.loads(rest)
				if isinstance(args, dict):
					return [normalize_call({"name": name, "arguments": args})]
			except json.JSONDecodeError:
				pass
			# positional arguments (common small-model style: "read a.txt")
			# allow positional when fenced; for unfenced single-line bodies,
			# only when the args are a single token or quoted, to avoid
			# treating ordinary prose as a tool call
			single_line = "\n" not in body
			simple_args = (len(rest.split()) <= 1) or rest.startswith(("\"", "'"))
			if fenced or (single_line and simple_args):
				try:
					toks = shlex.split(rest)
				except ValueError:
					toks = rest.split()
				args = _positional_args(name, toks)
				return [normalize_call({"name": name, "arguments": args})]
		# json object/array anywhere in the body
		for m in re.finditer(r"(\{.*?\}|\[.*?\])", body, re.DOTALL):
			try:
				obj = json.loads(m.group(1))
			except json.JSONDecodeError:
				continue
			items = obj if isinstance(obj, list) else [obj]
			out = []
			for it in items:
				call = normalize_call(it)
				if call:
					out.append(call)
			if out:
				return out
		try:
			obj = json.loads(body)
		except json.JSONDecodeError:
			continue
		items = obj if isinstance(obj, list) else [obj]
		out = []
		for it in items:
			call = normalize_call(it)
			if call:
				out.append(call)
		if out:
			return out
	# bash fallback: a fenced block that is not a recognized tool call and
	# looks like a command (common when the model writes the command directly)
	if "bash" in ENABLED_TOOLS:
		for body, fenced, lang in _extract_bodies(text):
			if not fenced or not body.strip():
				continue
			if "\n" in body.strip():
				continue
			first = body.split(None, 1)[0] if body.split() else ""
			if first in TOOLS:
				continue
			if body.lstrip().startswith(("{", "[")):
				continue
			if lang and not ("tool" in lang or "bash" in lang or "sh" in lang or "shell" in lang):
				continue
			# only treat as a shell command if the first token is actually
			# an executable (or a known shell builtin); otherwise the fenced
			# text is almost certainly an answer, not a command
			if not _is_executable(first):
				continue
			return [normalize_call({"name": "bash", "arguments": {"command": body.strip()}})]
	return []


def normalize_call(obj):
	if not isinstance(obj, dict):
		return None
	if "function" in obj and isinstance(obj["function"], dict):
		f = obj["function"]
		name = f.get("name") or obj.get("name") or obj.get("type")
		args = f.get("arguments", f.get("parameters", {}))
	else:
		name = obj.get("name") or obj.get("type")
		args = obj.get("arguments", obj.get("parameters", {}))
	if not name:
		return None
	if isinstance(args, str):
		try:
			args = json.loads(args)
		except json.JSONDecodeError:
			args = {"_raw": args}
	if not isinstance(args, dict):
		args = {}
	return {"id": obj.get("id") or f"call_{uuid.uuid4().hex[:8]}", "function": {"name": name, "arguments": args}}


def ollama_chat(model, messages, tools=None, load_timeout=DEFAULT_MODEL_TIMEOUT_LOAD, idle_timeout=DEFAULT_MODEL_TIMEOUT_IDLE, host=None, options=None, think=None):
	payload = {"model": model, "messages": messages, "stream": True}
	if think is not None:
		payload["think"] = think
	if tools:
		payload["tools"] = tools
	if options:
		payload["options"] = options
	data = json.dumps(payload).encode()
	h, p = normalize_host(host)
	try:
		conn = http.client.HTTPConnection(h, p, timeout=load_timeout)
		conn.request("POST", "/api/chat", body=data, headers={"Content-Type": "application/json"})
		resp = conn.getresponse()
	except Exception as e:
		raise RuntimeError(f"cannot reach Ollama: {e}")
	if resp.status != 200:
		try:
			err = resp.read().decode(errors="replace")
		except Exception:
			err = ""
		conn.close()
		raise RuntimeError(f"Ollama HTTP {resp.status}: {err}")
	try:
		conn.sock.settimeout(idle_timeout)
	except Exception:
		pass
	content_parts = []
	tool_calls = None
	timings = None
	try:
		for raw in resp:
			line = raw.strip()
			if not line:
				continue
			try:
				chunk = json.loads(line)
			except json.JSONDecodeError:
				continue
			if isinstance(chunk, dict) and "error" in chunk:
				conn.close()
				raise RuntimeError(f"Ollama: {chunk['error']}")
			msg = chunk.get("message", {}) if isinstance(chunk, dict) else {}
			if isinstance(msg, dict):
				if msg.get("content"):
					content_parts.append(msg["content"])
				if msg.get("tool_calls"):
					tool_calls = msg["tool_calls"]
			if isinstance(chunk, dict) and chunk.get("done"):
				timings = {
					"load_duration_ns": chunk.get("load_duration"),
					"prompt_eval_count": chunk.get("prompt_eval_count"),
					"prompt_eval_duration_ns": chunk.get("prompt_eval_duration"),
					"eval_count": chunk.get("eval_count"),
					"eval_duration_ns": chunk.get("eval_duration"),
					"total_duration_ns": chunk.get("total_duration"),
				}
				break
	except socket.timeout:
		conn.close()
		raise RuntimeError(f"Ollama idle timeout ({idle_timeout}s with no data)")
	except Exception as e:
		conn.close()
		raise RuntimeError(f"Ollama stream error: {e}")
	conn.close()
	msg_out = {"role": "assistant", "content": "".join(content_parts), "tool_calls": tool_calls, "timings": timings}
	return msg_out


def build_tool_schemas(enabled):
	out = []
	for name in enabled:
		info = TOOLS.get(name)
		if not info:
			continue
		out.append({"type": "function", "function": {"name": name, "description": info["description"], "parameters": info["schema"]}})
	return out


def parse_args(argv):
	# returns (model, segments, config) or exits
	if not argv or argv[0] in ("-h", "--help"):
		print(HELP)
		sys.exit(0)
	# subcommand: list models
	if argv[0] in ("models", "list-models", "ls-models"):
		detail = False
		h = None
		i = 1
		n = len(argv)
		while i < n:
			if argv[i] == "--detail":
				detail = True
				i += 1
			elif argv[i] == "--host":
				if i + 1 >= n:
					fail("--host requires a value")
				h = argv[i + 1]
				i += 2
			else:
				fail(f"unknown flag: {argv[i]}")
		list_models(detail=detail, host=h)
		sys.exit(0)
	# flag-first models
	if argv[0] in ("--models", "--list-models"):
		detail = "--detail" in argv
		h = None
		if "--host" in argv:
			idx = argv.index("--host")
			if idx + 1 >= len(argv):
				fail("--host requires a value")
			h = argv[idx + 1]
		list_models(detail=detail, host=h)
		sys.exit(0)

	model = None
	segments = []  # list of tuples (kind, data)
	config = {
		"max_turns": 1,
		"idle_timeout": DEFAULT_MODEL_TIMEOUT_IDLE,
		"load_timeout": DEFAULT_MODEL_TIMEOUT_LOAD,
		"verbose": False,
		"system": [],
		"json": False,
		"options": {},
		"host": None,
		"think": None,
	}
	positionals = []
	i = 0
	n = len(argv)
	while i < n:
		tok = argv[i]
		if tok.startswith("--"):
			name = tok[2:]
			if name in ("prompt", "prompt-file"):
				if i + 1 >= n:
					fail(f"--{name} requires a value")
				kind = "prompt" if name == "prompt" else "prompt_file"
				segments.append((kind, argv[i + 1]))
				i += 2
				continue
			if name in ("file", "files"):
				i += 1
				files = []
				while i < n and not argv[i].startswith("--"):
					files.append(argv[i])
					i += 1
				if not files:
					fail("--file requires at least one path")
				segments.append(("file", files))
				continue
			if name in ("system",):
				if i + 1 >= n:
					fail("--system requires a value")
				config["system"].append(argv[i + 1])
				i += 2
				continue
			if name in ("max-turns", "turns", "max_turns"):
				if i + 1 >= n:
					fail(f"--{name} requires a value")
				try:
					v = int(argv[i + 1])
				except ValueError:
					fail(f"--{name} value must be an integer")
				if v < 1:
					fail(f"--{name} must be >= 1")
				config["max_turns"] = v
				i += 2
				continue
			if name in ("timeout", "idle-timeout", "idle_timeout"):
				if i + 1 >= n:
					fail(f"--{name} requires a value")
				try:
					v = int(argv[i + 1])
				except ValueError:
					fail(f"--{name} value must be an integer")
				if v < 1:
					fail(f"--{name} must be >= 1")
				config["idle_timeout"] = v
				i += 2
				continue
			if name in ("load-timeout", "load_timeout"):
				if i + 1 >= n:
					fail(f"--{name} requires a value")
				try:
					v = int(argv[i + 1])
				except ValueError:
					fail(f"--{name} value must be an integer")
				if v < 1:
					fail(f"--{name} must be >= 1")
				config["load_timeout"] = v
				i += 2
				continue
			if name in ("json",):
				config["json"] = True
				i += 1
				continue
			if name in ("option", "options"):
				if i + 1 >= n:
					fail(f"--{name} requires a value")
				raw = argv[i + 1]
				if "=" not in raw:
					fail(f"--{name} requires key=value")
				key, val = raw.split("=", 1)
				config["options"][key] = coerce_option_value(val)
				i += 2
				continue
			if name in ("host",):
				if i + 1 >= n:
					fail(f"--{name} requires a value")
				config["host"] = argv[i + 1]
				i += 2
				continue
			if name in ("think", "no-think"):
				config["think"] = name == "think"
				i += 1
				continue
			if name in ("verbose", "v"):
				config["verbose"] = True
				i += 1
				continue
			if name in ("models", "list-models"):
				detail = False
				h = config.get("host")
				j = i + 1
				while j < n and argv[j].startswith("--"):
					if argv[j] == "--detail":
						detail = True
						j += 1
					elif argv[j] == "--host":
						h = argv[j + 1]
						j += 2
					else:
						break
				list_models(detail=detail, host=h)
				sys.exit(0)
			if name in TOOLS:
				segments.append(("tool", name))
				i += 1
				continue
			fail(f"unknown flag: --{name}")
		else:
			positionals.append(tok)
			i += 1

	# resolve positionals: first = model, rest => prompt(s)
	if not positionals:
		fail("missing model (first argument)")
	model = positionals[0]
	if len(positionals) >= 2:
		# trailing positional prompt (shorthand for final --prompt)
		prompt_text = " ".join(positionals[1:])
		segments.append(("prompt", prompt_text))
	if len(positionals) > 2:
		# already joined; note ambiguity
		pass

	return model, segments, config


def vlog(config, msg):
	if config["verbose"]:
		sys.stderr.write(f"{NAME}: {msg}\n")


def main(argv):
	model, segments, config = parse_args(argv)

	# assemble
	enabled_tools = set()
	text_blocks = []
	for kind, data in segments:
		if kind == "prompt":
			text_blocks.append(data)
		elif kind == "prompt_file":
			text_blocks.append(read_prompt_file(data))
		elif kind == "file":
			for pth in data:
				content = read_file_text(pth)
				text_blocks.append(f"--- {pth} ---\n{content}")
		elif kind == "tool":
			enabled_tools.add(data)
			info = TOOLS[data]
			text_blocks.append(f"[tool available: {data} — {info['description']}]")

	global ENABLED_TOOLS
	ENABLED_TOOLS = set(enabled_tools)

	user_content = "\n\n".join(b for b in text_blocks if b.strip())
	if not user_content.strip():
		fail("no prompt provided (use --prompt, --prompt-file or a trailing prompt)")

	system_content = "\n\n".join(config["system"])

	messages = []
	if system_content.strip():
		messages.append({"role": "system", "content": system_content})
	messages.append({"role": "user", "content": user_content})

	tools_list = build_tool_schemas(enabled_tools)
	vlog(config, f"model={model} turns={config['max_turns']} tools={sorted(enabled_tools)}")

	json_mode = config["json"]
	options = config["options"]
	host = config["host"]
	think = config["think"]

	wall_start = time.time()
	tool_call_records = []
	timings_list = []
	final_content = None
	error = None
	turns_taken = 0
	last_call_sig = None
	repeated = False

	for turn in range(1, config["max_turns"] + 1):
		turns_taken = turn
		vlog(config, f"turn {turn}: calling model")
		try:
			assistant = ollama_chat(model, messages, tools_list if (turn <= config["max_turns"]) else None, config["load_timeout"], config["idle_timeout"], host=host, options=options, think=think)
		except RuntimeError as e:
			if json_mode:
				obj = {
					"model": model,
					"think": think,
					"content": "",
					"turns": turns_taken,
					"wall_time_s": time.time() - wall_start,
					"tool_calls": tool_call_records,
					"timings": timings_list,
					"error": str(e),
				}
				sys.stdout.write(json.dumps(obj))
				sys.stdout.write("\n")
				sys.exit(1)
			fail(str(e), 1)
		messages.append(assistant)
		content = assistant.get("content", "") or ""
		vlog(config, f"  assistant: {content[:400].replace(chr(10), ' ')}")
		t = assistant.get("timings")
		timing_entry = {
			"turn": turn,
			"load_duration_ns": None,
			"prompt_eval_count": None,
			"prompt_eval_duration_ns": None,
			"eval_count": None,
			"eval_duration_ns": None,
			"total_duration_ns": None,
		}
		if isinstance(t, dict):
			timing_entry["load_duration_ns"] = t.get("load_duration_ns")
			timing_entry["prompt_eval_count"] = t.get("prompt_eval_count")
			timing_entry["prompt_eval_duration_ns"] = t.get("prompt_eval_duration_ns")
			timing_entry["eval_count"] = t.get("eval_count")
			timing_entry["eval_duration_ns"] = t.get("eval_duration_ns")
			timing_entry["total_duration_ns"] = t.get("total_duration_ns")
		timings_list.append(timing_entry)

		tool_calls = assistant.get("tool_calls")
		source = None
		if not tool_calls:
			parsed = parse_tool_calls_from_content(content)
			if parsed:
				tool_calls = parsed
				source = "parsed"
		else:
			source = "native"

		if tool_calls:
			for tc in tool_calls:
				fn = tc.get("function", {})
				name = fn.get("name")
				args = fn.get("arguments", {})
				tool_call_records.append({"turn": turn, "name": name, "arguments": args, "source": source})

		if not tool_calls:
			final_content = content
			break

		# execute tool calls
		if turn >= config["max_turns"]:
			sys.stderr.write(f"{NAME}: model requested tool call but max-turns reached; not executed\n")
			error = "no final answer produced"
			break
		sigs = []
		for tc in tool_calls:
			fn = tc.get("function", {})
			name = fn.get("name")
			args = fn.get("arguments", {})
			sigs.append((name, json.dumps(args, sort_keys=True)))
		call_sig = tuple(sigs)
		if call_sig == last_call_sig:
			repeated = True
		last_call_sig = call_sig

		vlog(config, f"turn {turn}: {len(tool_calls)} tool call(s): {[tc.get('function',{}).get('name') for tc in tool_calls]}")

		if not repeated:
			for tc in tool_calls:
				fn = tc.get("function", {})
				name = fn.get("name")
				args = fn.get("arguments", {})
				vlog(config, f"  -> {name}({json.dumps(args)})")
				try:
					result = execute_tool(name, args)
				except Exception as e:
					result = f"[error: {e}]"
				if len(result) > MAX_TOOL_RESULT:
					result = result[:MAX_TOOL_RESULT] + f"\n... [truncated to {MAX_TOOL_RESULT} chars]"
				vlog(config, f"  <- {result[:200].replace(chr(10), ' ')}")
				messages.append({"role": "tool", "content": result, "tool_call_id": tc.get("id")})

		if repeated:
			vlog(config, "stopping: repeated identical tool call; forcing final answer")
			messages.append({"role": "user", "content": "You already have the tool result above. Answer the original request now in plain text, without calling any tools."})
			try:
				assistant2 = ollama_chat(model, messages, None, config["load_timeout"], config["idle_timeout"], host=host, options=options, think=think)
			except RuntimeError as e:
				if json_mode:
					obj = {
						"model": model,
						"think": think,
						"content": "",
						"turns": turns_taken,
						"wall_time_s": time.time() - wall_start,
						"tool_calls": tool_call_records,
						"timings": timings_list,
						"error": str(e),
					}
					sys.stdout.write(json.dumps(obj))
					sys.stdout.write("\n")
					sys.exit(1)
				fail(str(e), 1)
			messages.append(assistant2)
			content2 = assistant2.get("content", "") or ""
			t2 = assistant2.get("timings")
			te2 = {
				"turn": turn,
				"load_duration_ns": None,
				"prompt_eval_count": None,
				"prompt_eval_duration_ns": None,
				"eval_count": None,
				"eval_duration_ns": None,
				"total_duration_ns": None,
			}
			if isinstance(t2, dict):
				te2["load_duration_ns"] = t2.get("load_duration_ns")
				te2["prompt_eval_count"] = t2.get("prompt_eval_count")
				te2["prompt_eval_duration_ns"] = t2.get("prompt_eval_duration_ns")
				te2["eval_count"] = t2.get("eval_count")
				te2["eval_duration_ns"] = t2.get("eval_duration_ns")
				te2["total_duration_ns"] = t2.get("total_duration_ns")
			timings_list.append(te2)
			final_content = content2
			break
		if turn >= config["max_turns"]:
			vlog(config, "stopping: max turns reached")
			break

	if final_content is None and error is None:
		error = "no final answer produced"

	wall_time = time.time() - wall_start

	if json_mode:
		obj = {
			"model": model,
			"think": think,
			"content": final_content if final_content is not None else "",
			"turns": turns_taken,
			"wall_time_s": wall_time,
			"tool_calls": tool_call_records,
			"timings": timings_list,
			"error": error,
		}
		sys.stdout.write(json.dumps(obj))
		sys.stdout.write("\n")
		sys.exit(0 if error is None else 1)

	if final_content is not None:
		sys.stdout.write(final_content)
		if final_content and not final_content.endswith("\n"):
			sys.stdout.write("\n")
		return 0

	sys.stderr.write(f"{NAME}: no final answer produced\n")
	sys.exit(1)


if __name__ == "__main__":
	try:
		main(sys.argv[1:])
	except SystemExit:
		raise
	except KeyboardInterrupt:
		sys.stderr.write(f"{NAME}: interrupted\n")
		sys.exit(1)
	except Exception as e:
		fail(f"unexpected error: {e}", 1)
