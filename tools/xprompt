#!/usr/bin/env python3
"""xprompt - minimal blocking harness around Ollama for small models.

Usage:
  xprompt                       show this help
  xprompt --help                show this help
  xprompt models [--detail]     list models available in Ollama
  xprompt <model> [flags...] [prompt]

Positional:
  <model>    Ollama model name (first argument, no flag). Use 'xprompt models'
             to list available ones.

Flags (may repeat; order affects the assembled prompt):
  --prompt TEXT        prompt text (can be placed anywhere, incl. before tools)
  --prompt-file PATH   read the prompt from a UTF-8 file (same order as --prompt)
  --file PATH [PATH..] include one or more files (variadic, until next flag)
  --read               enable the 'read' tool (read a file's contents)
  --grep               enable the 'grep' tool (search text in files)
  --ls                 enable the 'ls' tool (list a directory, incl. hidden)
  --bash               enable the 'bash' tool (run a shell command)
  --write              enable the 'write' tool (write content to a file)
  --system TEXT        system message (concatenated if repeated)
  --max-turns N        tool-call loop limit (default 1; 1 = single shot)
  --timeout S          idle timeout between streamed chunks, seconds (default 120)
  --load-timeout S     time to wait for the model to start responding (default 300)
  --option KEY=VALUE   pass an Ollama option (temperature, seed, num_ctx,
                       num_gpu, num_thread, num_predict, ...); repeatable
  --host URL           Ollama host (default $OLLAMA_HOST or localhost:11434)
  --think/--no-think   force thinking on or off for thinking-capable models
  --json               print one JSON object (content, turns, tool_calls,
                       timings, error) instead of plain text
  --verbose            print turn/tool traces to stderr
  --models             list available models and exit

'models --detail' adds effective num_ctx, num_gpu and num_thread from
/api/show. The default listing shows name, size, parameters, quantization,
native context and capabilities.

The trailing unflagged positional prompt is shorthand for a final --prompt, so
the original 'xprompt <model> ... "prompt"' form keeps working.

Exit codes: 0 success, 1 runtime error (Ollama/model/tool failure, including a
run that produced no final answer), 2 usage error.
"""
import http.client
import json
import shlex
import shutil
import socket
import os
import re
import subprocess
import sys
import time
import uuid
from urllib.parse import urlparse

NAME = "xprompt"
DEFAULT_MODEL_TIMEOUT_LOAD = 300
DEFAULT_MODEL_TIMEOUT_IDLE = 120
MAX_FILE_BYTES = 20000
MAX_FILE_LINES = 200
MAX_TOOL_RESULT = 8000
MAX_GREP_MATCHES = 60

TOOLS = {
	"read": {
		"description": "Read the contents of a file.",
		"schema": {
			"type": "object",
			"properties": {"path": {"type": "string", "description": "file path"}},
			"required": ["path"],
		},
	},
	"grep": {
		"description": "Search for a pattern in a file or directory (recursive).",
		"schema": {
			"type": "object",
			"properties": {
				"pattern": {"type": "string", "description": "regex pattern"},
				"path": {"type": "string", "description": "file or directory (default .)"},
			},
			"required": ["pattern"],
		},
	},
	"ls": {
		"description": "List entries in a directory (including hidden files).",
		"schema": {
			"type": "object",
			"properties": {"path": {"type": "string", "description": "directory (default .)"}},
			"required": [],
		},
	},
	"bash": {
		"description": "Run a shell command and return its combined stdout/stderr and exit code.",
		"schema": {
			"type": "object",
			"properties": {
				"command": {"type": "string", "description": "shell command to run"},
				"timeout": {"type": "integer", "description": "timeout in seconds (default 30, max 120)"},
			},
