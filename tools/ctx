#!/bin/bash
# ctx - report opencode context-window usage for the current session.
#
# Token accounting comes from `opencode session export` (per-message usage is
# no longer stored in SQLite in opencode 2.x); session discovery uses the
# session_v2 table in ~/.local/share/opencode/opencode.db. The context limit
# comes from opencode's model cache (~/.cache/opencode/models.json).
#
# Usage:
#   ctx                  current session in $PWD (default)
#   ctx -a reviewer      only sessions belonging to a given agent
#   ctx --all            ignore the $OPENCODE_AGENT_ROLE hint
#   ctx -n 5             show the last 5 completed turns (trend)
#   ctx --json           machine-readable
#
# Inside an oc-agent session OPENCODE_AGENT_ROLE is set, so the default run
# already scopes to that agent. From a plain shell it falls back to whatever
# session last wrote in $PWD.
#
# Notes:
#   * Reports the last *completed* assistant turn, so during a long turn the
#     figure lags by one. In-flight messages land in the db with a null token
#     total and are skipped rather than reported as 0.
#   * "fresh" is uncached input; "cache read" is prompt-cache hits. Both
#     occupy the window, so context = sum of all five components.

set -uo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/opencode/models.json"
DB="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"

usage() { sed -n '3,21p' "$0" | sed 's/^#\{1,\} \{0,1\}//'; }

AGENT="${OPENCODE_AGENT_ROLE:-}"
NUM=1
JSON=0

die() { printf 'ctx: %s\n' "$1" >&2; exit "${2:-1}"; }

while (( $# )); do
	case $1 in
		-a|--agent) [[ $# -ge 2 ]] || die "$1 needs a value" 2; AGENT=$2; shift 2 ;;
		-n|--num) [[ $# -ge 2 ]] || die "$1 needs a value" 2; NUM=$2; shift 2 ;;
		--all) AGENT=""; shift ;;
		--json) JSON=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) die "unknown argument '$1' (try --help)" 2 ;;
	esac
done

[[ $NUM =~ ^[0-9]+$ ]] && (( NUM > 0 )) || die "-n must be a positive integer" 2
[[ -r $DB ]] || die "opencode database not found at $DB"

# Locate this session: match sessions rooted at $PWD, at a parent of $PWD, or
# at $PWD itself, so the script still works from a subdirectory. Uses
# substr/|| rather than LIKE, so a '_' in a path is not a single-char wildcard.
sq() { printf '%s' "${1//\'/\'\'}"; }
HERE=$(sq "$PWD")

# opencode 2.0 stores sessions in session_v2 and per-message token usage is no
# longer in SQLite (session_message has no token columns); it is only available
# through `opencode session export`. Discover candidate sessions from session_v2,
# then export each to read its assistant turns' token counts.
RAW=$(python3 - "$HERE" "$AGENT" "$NUM" <<'PY'
import json, os, sqlite3, subprocess, sys

here = sys.argv[1]
agent = sys.argv[2]
num = int(sys.argv[3])
base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
db = os.path.join(base, "opencode", "opencode.db")

header = ["model", "ts", "total", "fresh_in", "cache_read", "cache_write", "out_tok", "reason"]
print("\t".join(header))

# Filter by directory (session dir is HERE or an ancestor of HERE).
candidates = []
if agent:
    # re-query with directory info
    conn = sqlite3.connect("file:" + db + "?mode=ro", uri=True)
    qrows = conn.execute(
        "SELECT id, directory, time_updated FROM session_v2 WHERE agent = ? ORDER BY time_updated DESC",
        (agent,),
    ).fetchall()
    conn.close()
    for sid, d, _ in qrows:
        if d == here or here.startswith(d + "/"):
            candidates.append(sid)
else:
    conn = sqlite3.connect("file:" + db + "?mode=ro", uri=True)
    qrows = conn.execute(
        "SELECT id, directory, time_updated FROM session_v2 ORDER BY time_updated DESC"
    ).fetchall()
    conn.close()
    for sid, d, _ in qrows:
        if d == here or here.startswith(d + "/"):
            candidates.append(sid)

# Limit exports to a handful of most-recent sessions.
candidates = candidates[:8]

collected = []
for sid in candidates:
    try:
        res = subprocess.run(
            ["opencode", "session", "export", sid],
            capture_output=True, text=True, timeout=30,
        )
        if res.returncode != 0 or not res.stdout.strip():
            continue
        data = json.loads(res.stdout)
    except Exception:
        continue
    for m in data.get("messages", []):
        if m.get("type") != "assistant":
            continue
        tokens = m.get("tokens")
        if not tokens:
            continue
        cache = tokens.get("cache") or {}
        inp = tokens.get("input") or 0
        out = tokens.get("output") or 0
        reason = tokens.get("reasoning") or 0
        cr = cache.get("read") or 0
        cw = cache.get("write") or 0
        total = inp + cr + cw + out + reason
        model = m.get("model")
        if isinstance(model, dict):
            model = model.get("id", "")
        elif model is None:
            model = m.get("modelID", "")
        ts = (m.get("time") or {}).get("created")
        if ts is None:
            continue
        collected.append((model, int(ts), int(total), int(inp), int(cr), int(cw), int(out), int(reason)))

collected.sort(key=lambda r: r[1], reverse=True)
for r in collected[:num]:
    print("\t".join(str(x) for x in r))
PY
) || die "query failed:"$'\n'"$RAW"
# Strip the tsv header line. If the query returned no rows, RAW is just the
# header (no newline), so ROWS must be cleared — otherwise the header gets
# parsed as a data row and the render crashes.
if [[ "$RAW" == *$'\n'* ]]; then
	ROWS=${RAW#*$'\n'}
else
	ROWS=""
fi

if [[ -z ${ROWS//[[:space:]]/} ]]; then
	hint=""
	[[ -n $AGENT ]] && hint=" for agent '$AGENT'"
	if (( JSON )); then
		jq -n --arg h "$hint" '{error: ("no completed assistant turns" + $h)}'
	else
		printf 'ctx: no completed assistant turns%s in %s\n' "$hint" "$PWD"
		printf '     opencode only stores a turn once it completes - try --all, or -n 5\n'
	fi
	exit 0
fi

limit_of() {
	[[ -r $CACHE ]] || return 0
	jq -r --arg m "$1" \
		'[.[] | (.models // {})[$m].limit.context // empty] | first // empty' \
		"$CACHE" 2>/dev/null
}
maxout_of() {
	[[ -r $CACHE ]] || return 0
	jq -r --arg m "$1" \
		'[.[] | (.models // {})[$m].limit.output // empty] | first // empty' \
		"$CACHE" 2>/dev/null
}
pct_of() { # pct_of <total> <limit>
	awk -v t="$1" -v l="${2:-0}" \
		'BEGIN{ if (l > 0) printf "%.1f", t*100/l; else printf "null" }'
}
bar() { # bar <percent> [width]
	local pct=${1%%.*} w=${2:-24} n
	n=$(( (pct * w + 50) / 100 ))
	(( n > w )) && n=$w
	(( n < 1 && pct > 0 )) && n=1 # never render a non-zero load as empty
	(( n < 0 )) && n=0
	printf '%*s' "$n" '' | tr ' ' '#'
}
k() { printf "%'d" "$1"; }
at() { date -d "@$(( $1 / 1000 ))" '+%H:%M:%S' 2>/dev/null; }

if (( JSON )); then
	{
		printf '{"cwd":%s,"agent_filter":%s,"turns":[' \
			"$(jq -Rn --arg v "$PWD" '$v')" "$(jq -Rn --arg v "$AGENT" '$v')"
		sep=""
		while IFS=$'\t' read -r model ts total fresh_in cache_read cache_write out_tok reason; do
			[[ -n ${total:-} ]] || continue
			lim=$(limit_of "$model"); [[ -n $lim ]] || lim=null
			printf '%s' "$sep"; sep=$','
			jq -n -c \
				--arg model "$model" --arg at "$(at "$ts")" \
				--argjson total "$total" --argjson fresh_in "$fresh_in" \
				--argjson cache_read "$cache_read" --argjson cache_write "$cache_write" \
				--argjson output "$out_tok" --argjson reasoning "$reason" \
				--argjson limit "$lim" --argjson percent "$(pct_of "$total" "${lim:-0}")" \
				'{model:$model,at:$at,total:$total,limit:$limit,percent:$percent,
				  fresh_in:$fresh_in,cache_read:$cache_read,cache_write:$cache_write,
				  output:$output,reasoning:$reasoning}'
		done <<< "$ROWS"
		printf ']}\n'
	} | jq 'if (.turns|length) > 0 then . + {summary: .turns[0]} else . end'
	exit 0
fi

printf '\n  cwd      %s\n' "$PWD"
[[ -n $AGENT ]] && printf '  agent    %s\n' "$AGENT"

n=0
while IFS=$'\t' read -r model ts total fresh_in cache_read cache_write out_tok reason; do
	[[ -n ${total:-} ]] || continue
	n=$(( n + 1 ))
	lim=$(limit_of "$model")
	mo=$(maxout_of "$model")
	pct=$(pct_of "$total" "${lim:-0}")

	printf '\n  model    %s' "$model"
	[[ -n $lim ]] && printf '   window %s' "$(k "$lim")"
	[[ -n $mo ]] && printf '   max output %s' "$(k "$mo")"
	printf '\n'

	printf '  turn     %s' "$(at "$ts")"
	(( NUM > 1 )) && printf '   (%d of %d, newest first)' "$n" "$NUM"
	printf '\n'

	if [[ $pct != null ]]; then
		printf '  context  %s / %s  = %5s%%\n' "$(k "$total")" "$(k "$lim")" "$pct"
		printf '          [%s]\n' "$(bar "$pct")"
	else
		printf '  context  %s / unknown\n' "$(k "$total")"
	fi

	printf '  tokens   fresh %s | cache read %s | output %s | reasoning %s | cache write %s\n' \
		"$(k "$fresh_in")" "$(k "$cache_read")" "$(k "$out_tok")" "$(k "$reason")" \
		"$(k "$cache_write")"
done <<< "$ROWS"

if (( n > 1 )); then
	printf '\n  trend, oldest -> newest\n'
	while IFS=$'\t' read -r model ts total fresh_in cache_read cache_write out_tok reason; do
		[[ -n ${total:-} ]] || continue
		lim=$(limit_of "$model")
		p=$(pct_of "$total" "${lim:-0}")
		if [[ $p == null ]]; then
			printf '    %s  %12s\n' "$(at "$ts")" "$(k "$total")"
		else
			printf '    %s  %12s  [%s] %5s%%\n' \
				"$(at "$ts")" "$(k "$total")" "$(bar "$p" 18)" "$p"
		fi
	done <<< "$(printf '%s\n' "$ROWS" | tac)"
fi
printf '\n'
