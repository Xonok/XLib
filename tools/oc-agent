#!/bin/bash
# Named-agent launcher for opencode.
#
# Registers each launch in ~/.opencode/agents/<sessionID>.json, which is what
# `tools/marduk` watches. OpenCode v2 removed the per-process `--port 0` server
# that the old port files recorded, so the session id is the durable handle: it
# is created up front with the agent bound, then attached to.
AGENT="$1"

# The names `oc-agent <name>` accepts, asked of opencode itself: an agent may
# come from a file under .opencode/agent/, from a built-in, or from a plugin, so
# reading one directory would list names the launcher rejects and miss names it
# takes. Only primary-capable agents can head a session. Prints nothing if
# opencode cannot answer, which callers read as "unknown".
agent_names() {
	opencode api get /api/agent 2>/dev/null \
		| jq -r '.data[] | select(.mode=="all") | .name' 2>/dev/null \
		| sort -u
}

die() {
	echo "oc-agent: $1" >&2
	exit 1
}

if [ -z "$AGENT" ]; then
	echo "Available agents:"
	agent_names
	echo
	echo "Usage: oc-agent <agent-name>"
	exit 0
fi

# Refuse an unknown name whenever opencode can answer. An empty list means the
# question could not be asked, and a launcher that refuses every name then is
# worse than one that lets opencode fall back to its default agent.
names=$(agent_names)
if [ -n "$names" ] && ! printf '%s\n' "$names" | grep -qxF -- "$AGENT"; then
	echo "Unknown agent: $AGENT" >&2
	echo "Available: $(printf '%s' "$names" | tr '\n' ' ')" >&2
	echo "Usage: oc-agent <agent-name>   (run oc-agent with no arguments to list them)" >&2
	exit 1
fi

# Claim a slot for this launch. The slot number names the window, so two
# terminals running the same agent stay distinguishable.
STATE="/tmp/oc-agent/$AGENT"
mkdir -p "$STATE"

for slotdir in "$STATE"/"$AGENT".*; do
	[ -d "$slotdir" ] || continue
	pidfile="$slotdir/pid"
	[ -f "$pidfile" ] || { rm -rf "$slotdir"; continue; }
	pid=$(<"$pidfile")
	if ! kill -0 "$pid" 2>/dev/null; then rm -rf "$slotdir"; fi
done

N=""
for i in $(seq 1 99); do
	if mkdir "$STATE/$AGENT.$i" 2>/dev/null; then N=$i; break; fi
done
[ -n "$N" ] || die "all 99 slots busy for '$AGENT'"

echo $$ > "$STATE/$AGENT.$N/pid"
TITLE="$AGENT"; [ "$N" -gt 1 ] && TITLE="$AGENT-$N"
printf '\033]2;%s\007' "$TITLE"
# OpenCode v2 dropped OPENCODE_DISABLE_TERMINAL_TITLE and sets its own title
# ("OC | <agent>") over ours. Turn that off for this window only, so the
# terminal shows the agent and slot. jq merges into any existing inline config;
# the global cli.json is left untouched.
existing_cli_config="$OPENCODE_CLI_CONFIG_CONTENT"
if [ -n "$existing_cli_config" ] && printf '%s' "$existing_cli_config" | jq -e . >/dev/null 2>&1; then
	export OPENCODE_CLI_CONFIG_CONTENT=$(printf '%s' "$existing_cli_config" | jq -c '. + {terminal:{title:false}}')
else
	export OPENCODE_CLI_CONFIG_CONTENT='{"terminal":{"title":false}}'
fi
export OPENCODE_AGENT_ROLE="$AGENT"

registry_dir="$HOME/.opencode/agents"
mkdir -p "$registry_dir"
registry_file=""

cleanup() {
	[ -n "$registry_file" ] && rm -f "$registry_file"
	rm -rf "$STATE/$AGENT.$N"
}
trap cleanup EXIT

# The project directory. This must be the terminal's own path: the service
# resolves `/api/location` to its own home, not to the calling project, so
# asking it would label every session with the wrong workspace.
project_dir="$PWD"

# Create the session with the agent already bound, so the window opens on the
# right agent without a switch. Location is explicit because the service
# resolves it from its own working directory otherwise, not this terminal's.
created=$(opencode api post /api/session --data "$(jq -nc \
	--arg agent "$AGENT" \
	--arg title "$TITLE" \
	--arg dir "$project_dir" \
	'{agent:$agent,title:$title,location:{directory:$dir}}')" 2>/dev/null)

session_id=$(printf '%s' "$created" | jq -r '.data.id // empty' 2>/dev/null)
[ -n "$session_id" ] || die "could not create a session for '$AGENT' (is the opencode service running? try: opencode service status)"

# One file per session, named for the id so a stale entry is unambiguous.
registry_file="$registry_dir/$session_id.json"
jq -nc \
	--arg session "$session_id" \
	--arg role "$TITLE" \
	--arg agent "$AGENT" \
	--arg dir "$project_dir" \
	--argjson slot "$N" \
	--argjson pid "$$" \
	'{session_id:$session,role:$role,agent:$agent,workspace:$dir,slot:$slot,pid:$pid,started_at:(now*1000|floor)}' \
	> "$registry_file" 2>/dev/null

# Attach to the session just created. Run in the current project directory
# (agents are global via ~/.config/opencode/agent).
opencode --session "$session_id" --log-level warn
exit $?