#!/bin/bash
# Named-agent launcher for opencode.
#
# Creates the session with the agent and its model bound, then attaches the TUI
# to it. OpenCode v2 removed the per-process `--port 0` server that the old port
# files recorded, so the session id is the handle: it is created up front with
# the agent bound, then attached to.
AGENT="$1"

# The agent list, asked of opencode itself: an agent may come from a file under
# .opencode/agent/, from a built-in, or from a plugin, so reading one directory
# would list names the launcher rejects and miss names it takes. Both the name
# check and the model lookup read this one answer. Empty when opencode cannot
# answer, which callers read as "unknown".
agents_json=$(opencode api get /api/agent 2>/dev/null)

# The names `oc-agent <name>` accepts. Only primary-capable agents can head a
# session.
agent_names() {
	printf '%s' "$agents_json" \
		| jq -r '.data[] | select(.mode=="all") | .name' 2>/dev/null \
		| sort -u
}

die() {
	echo "oc-agent: $1" >&2
	exit 1
}

if [ -z "$AGENT" ]; then
	echo "Available agents:"
	agent_names
	echo
	echo "Usage: oc-agent <agent-name>"
	exit 0
fi

# Refuse an unknown name whenever opencode can answer. An empty list means the
# question could not be asked, and a launcher that refuses every name then is
# worse than one that lets opencode fall back to its default agent.
names=$(agent_names)
if [ -n "$names" ] && ! printf '%s\n' "$names" | grep -qxF -- "$AGENT"; then
	echo "Unknown agent: $AGENT" >&2
	echo "Available: $(printf '%s' "$names" | tr '\n' ' ')" >&2
	echo "Usage: oc-agent <agent-name>   (run oc-agent with no arguments to list them)" >&2
	exit 1
fi

# Take this window's name from agent-coord. It is the one allocator: the number
# in the title is the number every tool in the session reports, and the notes
# file is the one that number names. Allocating it here would be a second
# allocator, which is exactly the disagreement this replaces. The key is this
# launcher's pid: it lives as long as the window, and the client that owns the
# session is its child, so the window can be named before that client exists.
self="$(readlink -f "$0")"
coord="$(dirname "$self")/agent-coord.py"
id="$(python3 "$coord" allocate --pid $$ --role "$AGENT")" \
	|| die "could not allocate an instance for '$AGENT'"
[ -n "$id" ] || die "agent-coord returned no id for '$AGENT'"

# Every window carries its number, the first included: a bare `secretary` was
# really secretary-1, and a name that sometimes has a number and sometimes not
# is the same disagreement this ticket removes, one level down.
TITLE="${id##*/}"
printf '\033]2;%s\007' "$TITLE"
# OpenCode v2 dropped OPENCODE_DISABLE_TERMINAL_TITLE and sets its own title
# ("OC | <agent>") over ours. Turn that off for this window only, so the
# terminal shows the agent and slot. jq merges into any existing inline config;
# the global cli.json is left untouched.
existing_cli_config="$OPENCODE_CLI_CONFIG_CONTENT"
if [ -n "$existing_cli_config" ] && printf '%s' "$existing_cli_config" | jq -e . >/dev/null 2>&1; then
	export OPENCODE_CLI_CONFIG_CONTENT=$(printf '%s' "$existing_cli_config" | jq -c '. + {terminal:{title:false}}')
else
	export OPENCODE_CLI_CONFIG_CONTENT='{"terminal":{"title":false}}'
fi
# Three names for one identity, exported so the session carries all of them: the
# role the tool files and the board use, the id agent-coord allocated, and the
# window name the title is made of (a `/new` session has no title of its own,
# and this is what lets the title plugin put the window's name on it).
export OPENCODE_AGENT_ROLE="$AGENT"
export OPENCODE_AGENT_ID="$id"
export OPENCODE_AGENT_NAME="$TITLE"

cleanup() {
	python3 "$coord" free --pid $$ >/dev/null 2>&1 || true
}
trap cleanup EXIT

# The project directory. This must be the terminal's own path: the service
# resolves `/api/location` to its own home, not to the calling project, so
# asking it would label every session with the wrong workspace.
project_dir="$PWD"

# The session stores its own model: binding an agent does not select that
# agent's model (opencode v2, Agents → Model), and a session created with
# `agent` alone runs the global default — which makes the agent file's pin
# silently do nothing. `/api/agent` reports the resolved Model.Ref, so hand it
# to the session. `null` when the agent has none, which keeps the global
# default, exactly as before.
agent_model=$(printf '%s' "$agents_json" | jq -c --arg name "$AGENT" \
	'.data[] | select(.name==$name) | .model // empty' 2>/dev/null | head -n 1)
[ -n "$agent_model" ] || agent_model=null

# Create the session with the agent and its model already bound, so the window
# opens on the right agent without a switch and on the model the file pins.
# Location is explicit because the service resolves it from its own working
# directory otherwise, not this terminal's.
created=$(opencode api post /api/session --data "$(jq -nc \
	--arg agent "$AGENT" \
	--arg title "$TITLE" \
	--arg dir "$project_dir" \
	--argjson model "$agent_model" \
	'{agent:$agent,title:$title,model:$model,location:{directory:$dir}}')" 2>/dev/null)

session_id=$(printf '%s' "$created" | jq -r '.data.id // empty' 2>/dev/null)
[ -n "$session_id" ] || die "could not create a session for '$AGENT' (is the opencode service running? try: opencode service status)"

# Attach to the session just created. Run in the current project directory
# (agents are global via ~/.config/opencode/agent).
#
# Run the TUI in the background so the script can wait for it and hold the
# window's identity until the window closes.
#
# An asynchronous command is handed /dev/null for stdin when job control is off,
# which is exactly this script: the TUI opens, draws, and never sees a keystroke,
# while the terminal echoes the typing over its own output. So the terminal is
# kept on a spare descriptor above and handed back explicitly.
exec 3<&0
opencode --session "$session_id" --log-level warn <&3 &
oc_pid=$!

wait "$oc_pid"
exit $?